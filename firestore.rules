rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bootstrapped admin email from metadata and Firestore role verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mkwebsitedeveloper@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mohammedkaifraut@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin@civicconnect.gov') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'department_head'))
      );
    }

    // Default deny for unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Public civic complaints
    match /complaints/{complaintId} {
      // Complaints are public to view for city transparency and map display
      allow read: if true;
      // Authenticated citizens and admins can report issues
      allow create: if isSignedIn();
      // Authenticated users can upvote/confirm, admins can change status and dispatch
      allow update: if isSignedIn();
      // Only admins or the original reporter can delete
      allow delete: if isAdmin() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
    }

    // Municipal departments config
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
